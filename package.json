{
  "name": "repoport",
  "version": "0.1.0",
  "description": "Local-first repository fleet dashboard for maintainers juggling many repos.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "repoport": "./src/bin/repoport.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --test",
    "build": "node --eval \"import('./src/index.js')\"",
    "smoke": "node ./src/bin/repoport.js --help"
  },
  "keywords": [
    "git",
    "github",
    "dashboard",
    "cli",
    "local-first",
    "oss"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/repoport.git"
  },
  "homepage": "https://github.com/rogerchappel/repoport#readme",
  "bugs": {
    "url": "https://github.com/rogerchappel/repoport/issues"
  }
}
