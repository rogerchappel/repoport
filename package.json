{
  "name": "repoport",
  "version": "0.1.0",
  "description": "Local-first repository fleet dashboard for maintainers juggling many repos.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "repoport": "./src/bin/repoport.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "find src test tests -name '*.js' -print0 | xargs -0 -n1 node --check && node --eval \"import('./src/index.js')\"",
    "build": "node --eval \"import('./src/index.js')\"",
    "smoke": "node ./src/bin/repoport.js --help",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke",
    "release:readiness": "node scripts/validate-release-readiness.mjs"
  },
  "keywords": [
    "git",
    "github",
    "dashboard",
    "cli",
    "local-first",
    "oss"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/repoport.git"
  },
  "homepage": "https://github.com/rogerchappel/repoport#readme",
  "bugs": {
    "url": "https://github.com/rogerchappel/repoport/issues"
  }
}
